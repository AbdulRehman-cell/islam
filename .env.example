# Server Network Configuration
PORT=10000
NODE_ENV=production

# Database Connection String (MongoDB Atlas or hosted MongoDB instance)
# Format: mongodb+srv://<username>:<password>@cluster.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/islam_db?retryWrites=true&w=majority

# Authentication Security
# Strong, cryptographically random secret string used for signing JWT tokens
JWT_SECRET=super_secret_jwt_key_at_least_32_characters_long

# CORS Policy
# Exact allowed origin domain for cross-origin requests (e.g., https://your-app.onrender.com)
CORS_ORIGIN=https://your-app-name.onrender.com